# Hostinger / Apache — segurança + UTF-8
AddDefaultCharset UTF-8
DirectoryIndex index.html

Options -Indexes
ServerSignature Off

# PHP da API
<IfModule mod_php.c>
  php_flag display_errors Off
</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

# Bloqueia arquivos sensíveis / restos de deploy
<FilesMatch "(?i)^(\.env|\.git|\.htpasswd|.*\.(bak|sql|log|ini|pem|key)|composer\.(json|lock)|package(-lock)?\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Não servir zips / dumps acidentais na raiz pública
<FilesMatch "(?i)\.(zip|tar|gz|rar|7z|sql|dump)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # CSP: só recursos locais (sem CDN). Ajustar se adicionar fontes/scripts externos.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net"
  # HSTS (Hostinger já usa HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Força HTTPS se o host ainda receber HTTP
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
